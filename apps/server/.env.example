# API, webhooks, voice gateway and worker (apps/server). Copy to .env.local (never commit it) and fill in;
# `npm start`, `npm run worker` and `npm run dev:stack` read .env.local by themselves.
# For local development without any accounts, `npm run dev:stack` sets all of this. The only line worth
# adding there is CHAT_AI_API_KEY, so the dashboard's chat test uses a real AI.

NODE_ENV=production
LOG_LEVEL=info
PORT=8080

# Where this server is reachable from the internet (Twilio and Square sign requests to these URLs),
# and the dashboard's origin (the only site allowed to call the API from a browser).
PUBLIC_API_BASE_URL=
DASHBOARD_ORIGIN=

# Postgres (Supabase). DATABASE_URL is the login role the API and worker use; it must be a member of
# app_rw and nothing more. DATABASE_MIGRATE_URL is the table owner, used only by `npm run migrate`.
# APP_DB_ROLE (optional) is granted app_rw by the migrate script.
DATABASE_URL=
DATABASE_MIGRATE_URL=
APP_DB_ROLE=

# Supabase Auth. The API only verifies tokens against the project's public keys (asymmetric signing keys
# must be enabled). The service role key is used for one thing: a person deleting their own account.
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=

# 32 random bytes, base64 (openssl rand -base64 32). Encrypts Square tokens at rest.
TOKEN_ENCRYPTION_KEY=
TOKEN_KEY_VERSION=1
# Only during a key rotation: the previous key, for version TOKEN_KEY_VERSION - 1.
TOKEN_ENCRYPTION_KEY_PREVIOUS=
# 32+ random characters. Signs the one-time pass that opens a call's media stream.
VOICE_STREAM_SECRET=

# Twilio (your own account). The API key, secret and TwiML app are for the browser test call.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
# A Twilio-hosted TwiML Bin, used if this server is down: <Response><Dial>{{dial}}</Dial></Response>
TWILIO_FALLBACK_TWIML_URL=
# Messaging service for staff alert texts (needs A2P 10DLC registration).
TWILIO_MESSAGING_SERVICE_SID=

# OpenAI Realtime (your own key). The model is pinned here, never chosen at call time.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime

# The dashboard's chat test (AI agent > Chat test): any OpenAI-compatible text model. Groq has a free tier:
# create a key at https://console.groq.com/keys. For xAI's Grok (paid) use https://api.x.ai/v1 and a Grok model.
CHAT_AI_API_KEY=
CHAT_AI_BASE_URL=https://api.groq.com/openai/v1
CHAT_AI_MODEL=openai/gpt-oss-120b

# Square (your own developer app; sandbox and production are separate apps).
SQUARE_API_VERSION=2026-08-19
SQUARE_APPLICATION_ID_SANDBOX=
SQUARE_APPLICATION_SECRET_SANDBOX=
SQUARE_APPLICATION_ID_PRODUCTION=
SQUARE_APPLICATION_SECRET_PRODUCTION=
# The webhook subscription's signature key, and the exact notification URL you registered with Square.
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=

# Resend, from a domain you verified (SPF and DKIM set).
RESEND_API_KEY=
EMAIL_FROM=

# Optional.
ESTIMATED_COST_PER_MINUTE_MINOR=0
DRAIN_SECONDS=900
SENTRY_DSN=
