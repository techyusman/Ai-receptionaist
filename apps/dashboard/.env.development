# Local development defaults for `next dev`, matching `npm run dev:stack` (Next.js never loads this file
# for `next build` or `next start`). Nothing here is secret. To point at real services, put the values in
# .env.local, which overrides this file and is never committed.
API_BASE_URL=http://localhost:4000
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=dev
DEV_SIGN_IN_HINT=1
