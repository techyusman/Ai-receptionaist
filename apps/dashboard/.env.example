# Dashboard (apps/dashboard). Copy to .env.local (never commit it) and fill in.

# The API (apps/server), reached from this server only; the browser never calls it directly.
API_BASE_URL=

# Supabase Auth: the project URL and its publishable (anon) key. Sign-in codes are sent by Supabase.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Local development only: shows the "use code 246810" note on the sign-in page. Never set in production.
DEV_SIGN_IN_HINT=
